# Supabase (públicas: seguras de exponer, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# IA Multi-Proveedor (solo servidor - usa cualquiera de los 4)
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
AI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
AI_MAX_OUTPUT_TOKENS=3000
AI_RATE_LIMIT_PER_HOUR=35
